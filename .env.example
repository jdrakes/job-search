# Copy to .env. Each line says who reads it.
# The one store: the database the run writes and the list reads (a Supabase project's session pooler, port 5432, sslmode=no-verify). Read by src/store/open.ts.
JOB_SEARCH_DB_URL=
# A separate database the Postgres half of npm test writes and deletes rows in; never the store of record.
JOB_SEARCH_TEST_DB_URL=postgresql://postgres:postgres@127.0.0.1:55432/job_search_test
# The REST endpoint the browser calls. Read by scripts/write-ui-config.ts.
SUPABASE_URL=
# The public key the browser signs in with. Read by scripts/write-ui-config.ts.
SUPABASE_ANON_KEY=

# Per-operator behaviour (the User-Agent, which discovery sources run, and an
# optional private source) is not read from .env. It lives in the gitignored
# settings/config.json, read by src/settings.ts.
