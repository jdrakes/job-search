# Copy to .env. Each line says who reads it.
# The store of record: the archive Postgres container. Read by src/store/open.ts and npm test.
JOB_SEARCH_DB_URL=postgresql://postgres:postgres@127.0.0.1:55432/job_search
# The hosted store the list reads: Supabase's session pooler, port 5432, sslmode=no-verify. Read by src/daily.ts.
SUPABASE_DB_URL=
# The REST endpoint the browser calls. Read by scripts/write-ui-config.ts.
SUPABASE_URL=
# The public key the browser signs in with. Read by scripts/write-ui-config.ts.
SUPABASE_ANON_KEY=

# Per-operator behaviour (the User-Agent, which discovery sources run, and an
# optional private source) is not read from .env. It lives in the gitignored
# settings/config.json, read by src/settings.ts.
